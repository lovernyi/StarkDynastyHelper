<Window x:Class="StarkDynastyHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stark Helper" Height="460" Width="880"
        WindowStyle="None" ResizeMode="CanMinimize" Background="#07080C"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True">

    <Window.Resources>
        <Style TargetType="Button" x:Key="AnimatedButtonStyle">
            <Setter Property="Background" Value="#131825"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="1" Background="#07080C" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ШАПКА ОКНА -->
            <Grid Grid.Row="0" Background="#0B0F19" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="STARK HELPER • v3.0" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                    <Button x:Name="PinBtn" Content="📌" Width="26" Height="26" Style="{StaticResource AnimatedButtonStyle}" Foreground="#64748B" Click="PinBtn_Click" ToolTip="Поверх окон"/>
                    <Button x:Name="MuteBtn" Content="🔊" Width="26" Height="26" Style="{StaticResource AnimatedButtonStyle}" Foreground="#64748B" Click="MuteBtn_Click" ToolTip="Звук"/>
                    <Button Content="—" Width="26" Height="26" Style="{StaticResource AnimatedButtonStyle}" Foreground="#64748B" Click="MinBtn_Click"/>
                    <Button Content="✕" Width="26" Height="26" Style="{StaticResource AnimatedButtonStyle}" Foreground="#EF4444" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- ОСНОВНОЙ МАКЕТ: ЛЕВОЕ МЕНЮ + КОНТЕНТ СПРАВА -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ПОСТОЯННОЕ ЛЕВОЕ МЕНЮ -->
                <Border Grid.Column="0" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Background="#0A0E17">
                    <StackPanel Margin="12">
                        <TextBlock Text="НАВИГАЦИЯ" Foreground="#475569" FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Button Content="🛡 Контракты" Style="{StaticResource AnimatedButtonStyle}" HorizontalContentAlignment="Left" Height="30" FontSize="11" Click="NavContracts_Click" Margin="0,0,0,3" Padding="8,0"/>
                        <Button Content="📢 Новости" Style="{StaticResource AnimatedButtonStyle}" HorizontalContentAlignment="Left" Height="30" FontSize="11" Click="NavNews_Click" Margin="0,0,0,3" Padding="8,0"/>
                        <Button Content="⚙️ Настройки" Style="{StaticResource AnimatedButtonStyle}" HorizontalContentAlignment="Left" Height="30" FontSize="11" Click="NavSettings_Click" Margin="0,0,0,3" Padding="8,0"/>
                        <Button Content="👤 Профиль" Style="{StaticResource AnimatedButtonStyle}" HorizontalContentAlignment="Left" Height="30" FontSize="11" Click="NavProfile_Click" Margin="0,0,0,12" Padding="8,0"/>
                        <Separator Background="#131825" Margin="0,0,0,12"/>
                        <Button Content="🎯 Выбрать зону ROI" Style="{StaticResource AnimatedButtonStyle}" Foreground="#3B82F6" HorizontalContentAlignment="Left" Height="26" FontSize="10" Click="SelectRoiInteractive_Click" Margin="0,0,0,3" Padding="8,0"/>
                        <Button Content="🔄 Сброс данных" Style="{StaticResource AnimatedButtonStyle}" Foreground="#EF4444" HorizontalContentAlignment="Left" Height="26" FontSize="10" Click="ResetBtn_Click" Padding="8,0"/>
                    </StackPanel>
                </Border>

                <!-- ПРАВАЯ ОБЛАСТЬ КОНТЕНТА -->
                <Grid Grid.Column="1" Background="#07080C">

                    <!-- 1. ВКЛАДКА: КОНТРАКТЫ -->
                    <ScrollViewer x:Name="ViewContracts" VerticalScrollBarVisibility="Auto" Padding="16" Visibility="Visible">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                <TextBlock x:Name="StatusTxt" Text="🎮 Ожидание запуска игры..." Foreground="#10B981" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                            </Border>

                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                                <Border Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="🍔 Курьер фастфуда" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="FoodStatusTxt" Text="⏳ Ожидание..." Foreground="#64748B" FontSize="10" Margin="0,0,0,5"/>
                                        <ProgressBar x:Name="FoodPb" Height="3" Maximum="100" Value="0" Foreground="#10B981" Background="#131825" BorderThickness="0" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="FoodCdTxt" Text="Готов" Foreground="#10B981" FontSize="10" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="Старт" Style="{StaticResource AnimatedButtonStyle}" Height="24" FontSize="10" Click="ManualStartFood_Click"/>
                                            <Button Content="Сдал" Style="{StaticResource AnimatedButtonStyle}" Height="24" FontSize="10" Click="ManualFinishFood_Click" Margin="4,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔧 Тюнинг II" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TuningStatusTxt" Text="⏳ Ожидание..." Foreground="#64748B" FontSize="10" Margin="0,0,0,5"/>
                                        <ProgressBar x:Name="TuningPb" Height="3" Maximum="100" Value="0" Foreground="#3B82F6" Background="#131825" BorderThickness="0" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TuningCdTxt" Text="Готов" Foreground="#10B981" FontSize="10" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="Старт" Style="{StaticResource AnimatedButtonStyle}" Height="24" FontSize="10" Click="ManualStartTuning_Click"/>
                                            <Button Content="Сдал" Style="{StaticResource AnimatedButtonStyle}" Height="24" FontSize="10" Click="ManualFinishTuning_Click" Margin="4,0,0,0"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                                <UniformGrid Columns="3">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ВСЕГО" Foreground="#475569" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TotalStatsTxt" Text="0" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="СЕГОДНЯ" Foreground="#475569" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TodayStatsTxt" Text="0" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ТОЧНОСТЬ" Foreground="#475569" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="EfficiencyTxt" Text="100%" Foreground="#10B981" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <Border Grid.Row="3" Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="ЖУРНАЛ СОБЫТИЙ" Foreground="#475569" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Border Background="#040507" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Height="90" Padding="5">
                                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="LogTxt" Text="[00:00:00] Инициализация..." Foreground="#64748B" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="4" Text="Stark Dynasty • by Lance Stark" Foreground="#1E293B" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- 2. ВКЛАДКА: НОВОСТИ -->
                    <StackPanel x:Name="ViewNews" Background="#07080C" Margin="16" Visibility="Collapsed">
                        <TextBlock Text="📢 НОВОСТИ ПРОЕКТА" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="NewsTitleView" Text="Загрузка..." Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock x:Name="NewsTextView" Text="Пожалуйста, подождите..." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. ВКЛАДКА: НАСТРОЙКИ -->
                    <ScrollViewer x:Name="ViewSettings" Background="#07080C" Padding="16" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⚙️ НАСТРОЙКИ СИСТЕМЫ" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Border Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="EnableTgChk" Content="Telegram уведомления" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,6"/>
                                    <TextBlock Text="Telegram ID:" Foreground="#64748B" FontSize="10" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TgChatIdTxt" Height="26" Background="#07080C" Foreground="#F8FAFC" BorderBrush="#131825" BorderThickness="1" VerticalContentAlignment="Center" Padding="6,0" FontSize="11" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="OverlayChk" Content="Включить мини-виджет поверх игры" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,6" Checked="OverlayChk_Checked" Unchecked="OverlayChk_Unchecked"/>
                                    <CheckBox x:Name="TrayChk" Content="Сворачивать в трей при закрытии" Foreground="#F8FAFC" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Выбрать свой звуковой файл (.wav)" Style="{StaticResource AnimatedButtonStyle}" Height="28" FontSize="10" Click="SelectCustomSound_Click" Margin="0,0,0,8"/>
                            <Button Content="Сохранить настройки" Height="30" Style="{StaticResource AnimatedButtonStyle}" Foreground="#10B981" Click="SaveSettings_Click" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 4. ВКЛАДКА: ПРОФИЛЬ -->
                    <StackPanel x:Name="ViewProfile" Background="#07080C" Margin="16" Visibility="Collapsed">
                        <TextBlock Text="👤 ПРОФИЛЬ ИГРОКА" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#0B0F19" BorderBrush="#131825" BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Разработчик: Lance Stark" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,5"/>
                                <TextBlock Text="Проект: Stark Dynasty" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ProfileKeyTxt" Text="Ключ: Загрузка..." Foreground="#10B981" FontSize="11" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ProfileHwidTxt" Text="HWID: Загрузка..." Foreground="#64748B" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>