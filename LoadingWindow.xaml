<Window x:Class="StarkDynastyHelper.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stark Helper - Auth &amp; Sync" Height="170" Width="460"
        WindowStyle="None" ResizeMode="NoResize" Background="#07080C"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border BorderBrush="#1E293B" BorderThickness="1" Background="#07080C" CornerRadius="6">
        <Grid Margin="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🛡 STARK DYNASTY • SECURE GATEWAY" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="StatusTxt" Text="Связь с сервером авторизации..." Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <ProgressBar x:Name="LoadPb" Height="3" Maximum="100" Value="0" Foreground="#10B981" Background="#131825" BorderThickness="0" Margin="0,0,0,10"/>
                <TextBlock Text="• developer: Lance Stark •" Foreground="#334155" FontSize="9" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>