<Window x:Class="StarkDynastyHelper.RoiSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select ROI" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" Background="#7F000000" AllowsTransparency="True"
        Cursor="Cross" MouseDown="Window_MouseDown" MouseMove="Window_MouseMove" MouseUp="Window_MouseUp">
    <Canvas>
        <Rectangle x:Name="SelectionBox" Stroke="#10B981" StrokeThickness="2" Fill="#3310B981" Visibility="Collapsed"/>
        <TextBlock Text="🖱 Зажмите ЛКМ и выделите область с контрактами на экране. Esc для отмены." Foreground="White" FontSize="14" FontWeight="Bold" Background="#CC000000" Padding="10,6" Canvas.Left="20" Canvas.Top="20"/>
    </Canvas>
</Window>