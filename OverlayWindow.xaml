<Window x:Class="StarkDynastyHelper.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stark Overlay" Height="45" Width="240"
        WindowStyle="None" ResizeMode="NoResize" Background="#CC07080C"
        AllowsTransparency="True" Topmost="True" WindowStartupLocation="Manual"
        Left="50" Top="50" MouseDown="Window_MouseDown">
    <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Background="#CC07080C" Padding="8,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🛡 STARK:" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="OverlayFoodTxt" Text="Фастфуд: Готов" Foreground="#10B981" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="OverlayTuningTxt" Text="Тюнинг: Готов" Foreground="#3B82F6" FontSize="10" VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>